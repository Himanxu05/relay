{
  "name": "relay",
  "version": "1.0.0",
  "description": "Reliable background job queue on Redis: retries with backoff, leases, dead-letter queue, dashboard",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "api": "tsx src/server.ts",
    "worker": "tsx src/demo-worker.ts",
    "bench:throughput": "tsx bench/throughput.ts",
    "bench:chaos": "tsx bench/chaos.ts"
  },
  "dependencies": {
    "express": "^5.3.0",
    "ioredis": "^6.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.4"
  }
}
